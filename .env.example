# Gemini server-side key. Set as a Secret in Vercel or in .env.local locally.
# Never put the actual key in GitHub, chat, screenshots or NEXT_PUBLIC_* variables.
ANALYZE_API_KEY=

# Optional model override. Default: gemini-3.8-flash.
# Free-tier availability and quotas depend on the Google project/model.
ANALYZE_MODEL=gemini-3.8-flash

# Emergency off switch. Set false to disable photo analysis; demo keeps working.
ANALYZE_ENABLED=true
