# Chave de API do provedor de modelo multimodal escolhido na etapa T-07.
# Consulte a documentação oficial do provedor antes de usar.
# NUNCA coloque o valor real neste arquivo — ele é commitado no repositório.
# Copie para .env.local e preencha localmente.
ANALYZE_API_KEY=

# Identificador do modelo a usar (ex.: nome do modelo conforme documentação do provedor).
# Deixe em branco para usar o padrão definido no código.
ANALYZE_MODEL=

# Endpoint base da API, se o provedor exigir URL customizada.
# Deixe em branco se o cliente do provedor usar o endpoint padrão.
ANALYZE_API_URL=
